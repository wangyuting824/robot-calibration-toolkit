#usda 1.0
(
    defaultPrim = "World"
    doc = """Synthetic two-joint reference imported with Isaac Sim 5.1.0; static regression fixture only
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "Flattened_Prototype_1"
{
    def Xform "mesh_0"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (0.699999988079071, 0.10000000149011612, 0.10000000149011612)
        double3 xformOp:translate = (0.3499999940395355, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "box"
        {
            float3[] extent = [(-0.35, -0.05, -0.05), (0.35, 0.05, 0.05)]
            double size = 1
        }
    }
}

over "Flattened_Prototype_2"
{
    def Xform "mesh_0"
    {
        uniform token purpose = "guide"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 0.10000000149011612, 0.10000000149011612)
        double3 xformOp:translate = (0.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "box" (
            apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.05, -0.05), (0.5, 0.05, 0.05)]
            double size = 1
        }
    }
}

